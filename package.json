{
  "name": "ngx-ratio-image",
  "version": "0.1.5",
  "author": {
    "name": "Gerd Siebert"
  },
  "engines": {
    "node": "^18.13.0 || ^20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerd-siebert/ngx-ratio-image.git"
  },
  "keywords": [
    "Image",
    "Scaling",
    "Ratio",
    "Angular 18",
    "Angular 19",
    "Angular 20",
    "Angular 21"
  ],
  "license": "MIT",
  "main": "dist/ngx-ratio-image/esm2022/ratio-image.mjs",
  "scripts": {
    "ng": "ng",
    "prettier": "prettier --write \"**/*.{js,json,css,scss,less,md,ts,html,component.html}\"",
    "start": "ng serve",
    "prebuild": "rimraf .angular dist && cp ./README.md ./LICENSE projects/ngx-ratio-image",
    "build": "echo 'Prepare-Builds' && npm run build:lib && npm run build:app",
    "build:lib": "ng build --project ratioImage --configuration production ",
    "build:app": "ng build --project ratioImageApp --configuration production ",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --code-coverage --no-watch --browsers=ChromeHeadless --source-map=false",
    "lint": "ng lint",
    "packagr": "ng-packagr -p ng-package.json",
    "publish": "rm -rf node_modules && npm install && npm run build && cd dist/ngx-ratio-image && npm publish && cd ../../",
    "version": "node ./copyVersion.js && npm pkg fix && git add projects/ngx-ratio-image/package.json",
    "prepare": "husky"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "19.2.22",
    "@angular/cdk": "19.2.19",
    "@angular/common": "19.2.22",
    "@angular/compiler": "19.2.22",
    "@angular/core": "19.2.22",
    "@angular/forms": "19.2.22",
    "@angular/material": "19.2.19",
    "@angular/platform-browser": "19.2.22",
    "@angular/platform-browser-dynamic": "19.2.22",
    "@angular/router": "19.2.22",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.26",
    "@angular-eslint/builder": "18.4.3",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/schematics": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "19.2.26",
    "@angular/compiler-cli": "19.2.22",
    "@schuchard/prettier": "5.1.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "20.19.41",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "husky": "9.1.7",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "latest",
    "ng-packagr": "^19.2.2",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.1",
    "tslint-config-prettier": "latest",
    "typescript": "5.5.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,json,css,scss,less,md,ts,html,component.html}": [
      "prettier --write"
    ]
  }
}
