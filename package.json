{
	"name": "my-monorepo-root",
	"version": "0.3.0",
	"private": true,
	"workspaces": [
		"main",
		"testing-app"
	],
	"scripts": {
		"start:main": "npm start --workspace=main",
		"start:testing-app": "npm start --workspace=testing-app",
		"prebuild:lib": "npm --prefix main run prebuild",
		"build:lib": "npm run build:lib --workspace=main",
		"build:testing-app": "npm run build --workspace=testing-app",
		"build": "npm run build:testing-app",
		"test:ci": "npm run test:ci --workspace=main",
		"publish": "npm run publish --workspace=main"
	},
	"dependencies": {
		"test": "0.0.0"
	},
	"devDependencies": {
		"rimraf": "6.1.3"
	},
	"allowScripts": {
		"husky@4.3.8": true,
		"@parcel/watcher@2.6.0": true,
		"lmdb@3.5.6": true,
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"esbuild@0.27.7": true,
		"lmdb@3.5.1": true,
		"msgpackr-extract@3.0.4": true
	}
}
