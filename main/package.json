{
	"name": "ngx-ratio-image",
	"version": "0.2.0",
	"author": {
		"name": "Gerd Siebert"
	},
	"engines": {
		"node": " ^20.19.0 || ^22.12.0 || ^24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gerd-siebert/ngx-ratio-image.git"
	},
	"keywords": [
		"Image",
		"Scaling",
		"Ratio",
		"Angular 20",
		"Angular 21"
	],
	"license": "MIT",
	"main": "dist/ngx-ratio-image/esm2022/ratio-image.mjs",
	"scripts": {
		"ng": "../node_modules/.bin/ng",
		"prettier": "prettier --write \"**/*.{js,json,css,scss,less,md,ts,html,component.html}\"",
		"start": "npm run ng -- serve",
		"prebuild": "rimraf .angular dist && cp ../README.md ../LICENSE projects/ngx-ratio-image",
		"build": "echo 'Prepare-Builds' && npm run build:lib && npm run build:app",
		"build:lib": "npm run ng -- build --project ratioImage --configuration production",
		"build:app": "npm run ng -- build --project ratioImageApp --configuration production",
		"watch": "npm run ng -- build --watch --configuration development",
		"test": "npm run ng -- test",
		"test:ci": "npm run ng -- test --code-coverage --no-watch --browsers=ChromeHeadless --source-map=false",
		"lint": "npm run ng -- lint",
		"packagr": "ng-packagr -p ng-package.json",
		"publish": "rm -rf node_modules && npm install && npm run build && cd dist/ngx-ratio-image && npm publish && cd ../../",
		"version": "node ./copyVersion.js && npm pkg fix && npm i --prefix projects/ngx-ratio-image && git add projects/ngx-ratio-image/package.json projects/ngx-ratio-image/package-lock.json",
		"prepare": "husky"
	},
	"private": false,
	"dependencies": {
		"@angular/animations": "^21.2.18",
		"@angular/cdk": "^21.2.2",
		"@angular/common": "^21.2.18",
		"@angular/compiler": "^21.2.18",
		"@angular/core": "^21.2.18",
		"@angular/forms": "^21.2.18",
		"@angular/material": "^21.2.2",
		"@angular/platform-browser": "^21.2.18",
		"@angular/platform-browser-dynamic": "^21.2.18",
		"@angular/router": "^21.2.18",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "18.4.3",
		"@angular-eslint/eslint-plugin": "18.4.3",
		"@angular-eslint/eslint-plugin-template": "18.4.3",
		"@angular-eslint/schematics": "18.4.3",
		"@angular-eslint/template-parser": "18.4.3",
		"@angular/build": "^21.2.19",
		"@angular/cli": "^21.2.19",
		"@angular/compiler-cli": "^21.2.18",
		"@schuchard/prettier": "5.1.0",
		"@types/jasmine": "~4.3.0",
		"@types/node": "20.19.41",
		"@typescript-eslint/eslint-plugin": "^7.2.0",
		"@typescript-eslint/parser": "^7.2.0",
		"eslint": "^8.57.0",
		"husky": "9.1.7",
		"jasmine-core": "~4.6.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"lint-staged": "15.5.2",
		"ng-packagr": "^21.2.2",
		"prettier": "2.8.8",
		"rimraf": "^5.0.1",
		"tslint-config-prettier": "latest",
		"typescript": "5.9.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,json,css,scss,less,md,ts,html,component.html}": [
			"prettier --write"
		]
	}
}
